# Dashboard
PORT=8787
HOST=127.0.0.1                 # anything else REQUIRES DASHBOARD_PASSWORD (+ put HTTPS in front)
# DASHBOARD_PASSWORD=change-me  # HTTP Basic auth (any username)

# Encryption key for stored API keys: 64 hex chars. If unset, data/master.key is generated.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# COPYTRADER_MASTER_KEY=

# Restart copy groups automatically after the server restarts (default: stay stopped = safer)
AUTO_START_GROUPS=false
